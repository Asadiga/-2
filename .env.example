# انسخ هذا الملف إلى .env ثم ضع قيمك الخاصة. لا تشارك هذا الملف مع أحد.
# مفتاح الذكاء الاصطناعي (اتركه فارغاً إن لم ترد تفعيل الرد الذكي بعد)
AI_API_KEY=
# رابط واجهة مزود الذكاء الاصطناعي المتوافق مع OpenAI (اختياري، عدّله حسب مزودك)
AI_API_URL=
# اسم النموذج لدى مزودك (اختياري)
AI_MODEL=
# رقم البوت لربطه برقم الهاتف بدلاً من QR (بصيغة دولية بلا +، مثال 249997560126)
# إن تركته فارغاً يستخدم البوت رمز QR.
PAIRING_NUMBER=249997560126
# الحد اليومي لعدد الرسائل: 0 = بلا حد (الافتراضي الآن)
DAILY_LIMIT=0
# اسم البوت الذي يظهر في رسالة الترحيب
BOT_NAME=أثير
# رقم الصادق فقط: البوت يرد على هذا الرقم وحده، ويتجاهل أي رقم آخر
OWNER_NUMBER=249127271642
# معرّف واتساب LID الخاص بالصادق: واتساب يرسل رسائله أحياناً بهذا
# المعرّف بدلاً من رقم الهاتف، فيجب قبوله أيضاً (مثال 158239916294218)
OWNER_LID=158239916294218
